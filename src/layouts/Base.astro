---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TagSidebar from '../components/TagSidebar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = '0x42sec.io — blog, research lab & personal ops',
  ogImage = '/og-image.png',
} = Astro.props;

const siteUrl = 'https://0x42sec.io';
const ogImageAbsolute = `${siteUrl}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} // 0x42sec</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={Astro.url}>
  <meta property="og:title" content={`${title} // 0x42sec`}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={Astro.url}>
  <meta property="og:image" content={ogImageAbsolute}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="627">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>
<body>
  <Nav />
  <div class="site-shell">
    <div class="site-content">
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
    <TagSidebar />
  </div>
</body>
</html>

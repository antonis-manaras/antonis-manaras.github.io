---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Projects" description="Active and completed security research projects by 0x42sec.">
  <div class="page-wrapper">
    <header class="page-header">
      <p class="page-eyebrow">projects</p>
      <h1 class="page-title">Projects</h1>
    </header>

    <hr class="section-divider">

    <div style="padding-top: 8px;">
      {projects.length === 0 ? (
        <p class="about-lead" style="color: var(--text-dim);">WIP — projects to be added soon.</p>
      ) : (
        <div class="blog-list">
          {projects.map(project => (
            <ProjectCard
              slug={project.slug}
              title={project.data.title}
              date={project.data.date}
              status={project.data.status}
              tags={project.data.tags}
              description={project.data.description}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</Base>

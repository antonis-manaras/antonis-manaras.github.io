---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Projects" description="Active and completed security research projects by 0x42sec.">
  <div class="page-wrapper">
    <header class="page-header">
      <p class="page-eyebrow">projects</p>
      <h1 class="page-title">Projects</h1>
    </header>

    <hr class="section-divider">

    <div style="padding-top: 48px;">
      {projects.length === 0 ? (
        <p class="about-lead" style="color: var(--text-dim);">WIP — projects to be added soon.</p>
      ) : (
        <div class="blog-list">
          {projects.map(project => (
            <div class="blog-card">
              <div class="blog-card-meta">
                <span class="blog-card-date">{project.data.date.toISOString().split('T')[0]}</span>
                <span class="blog-card-reading-time" style="color: var(--phosphor-amber);">[{project.data.status}]</span>
              </div>
              <h2 class="blog-card-title">{project.data.title}</h2>
              <p class="blog-card-description">{project.data.description}</p>
              <div class="blog-card-tags">
                {project.data.tags.map(tag => (
                  <span class="blog-tag">{tag}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</Base>

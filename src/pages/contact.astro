---
import Base from '../layouts/Base.astro';
import { CONTACT } from '../config/site.ts';
---

<Base title="Contact" description="Get in touch with 0x42sec — email, GitHub, LinkedIn, PGP.">
  <div class="page-wrapper">
    <header class="page-header">
      <p class="page-eyebrow">contact</p>
      <h1 class="page-title">Get in Touch</h1>
    </header>

    <hr class="section-divider">

    <div style="padding-top: 48px;">
      <div class="contact-grid">
        {CONTACT.channels.map(ch => (
          <div class="contact-card">
            <div class="contact-label">{ch.label}</div>
            <div class="contact-value">
              {ch.href
                ? <a href={ch.href} target="_blank" rel="noopener">{ch.value}</a>
                : ch.value
              }
            </div>
          </div>
        ))}
        <!-- {CONTACT.note && (
          <div class="contact-note">{CONTACT.note}</div>
        )} -->
      </div>
    </div>
  </div>
</Base>

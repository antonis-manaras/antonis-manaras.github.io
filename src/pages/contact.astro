---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch with 0x42sec — email, GitHub, LinkedIn, PGP.">
  <div class="page-wrapper">
    <header class="page-header">
      <p class="page-eyebrow">contact</p>
      <h1 class="page-title">Get in Touch</h1>
    </header>

    <hr class="section-divider">

    <div style="padding-top: 48px;">
      <div class="contact-grid">
        <div class="contact-card">
          <div class="contact-label">Email</div>
          <div class="contact-value">
            <a href="mailto:0x42sec@0x42sec.io">0x42sec@0x42sec.io</a>
          </div>
        </div>
        <div class="contact-card">
          <div class="contact-label">GitHub</div>
          <div class="contact-value">
            <a href="https://github.com/0x42sec" target="_blank" rel="noopener">github.com/0x42sec</a>
          </div>
        </div>
        <div class="contact-card">
          <div class="contact-label">LinkedIn</div>
          <div class="contact-value">
            <a href="https://linkedin.com/in/0x42sec" target="_blank" rel="noopener">linkedin.com/in/0x42sec</a>
          </div>
        </div>
        <div class="contact-card">
          <div class="contact-label">PGP</div>
          <div class="contact-value" style="color: var(--text-dim);">Available on request</div>
        </div>
        <p class="contact-note">
          Encrypted communications preferred. For security research enquiries, red team
          engagements, or collaborations — email is the best channel.
        </p>
      </div>
    </div>
  </div>
</Base>

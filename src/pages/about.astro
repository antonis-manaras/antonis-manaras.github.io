---
import Base from '../layouts/Base.astro';
import { ABOUT } from '../config/site.ts';
---

<Base title="About" description={ABOUT.lead}>
  <div class="page-wrapper">
    <header class="page-header">
      <p class="page-eyebrow">about</p>
      <h1 class="page-title">{ABOUT.handle}</h1>
    </header>

    <hr class="section-divider">

    <div class="about-body" style="padding-top: 48px;">
      <p class="about-lead">{ABOUT.lead}</p>
      {ABOUT.paragraphs.map(p => <p class="about-text">{p}</p>)}

      <div class="skills-section">
        <p class="skills-label">expertise</p>
        <div class="skill-list">
          {ABOUT.expertise.map(skill => <div class="skill-item">{skill}</div>)}
        </div>
      </div>
    </div>
  </div>
</Base>

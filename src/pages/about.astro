---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="About 0x42sec — security researcher, red team operator, RF/SIGINT enthusiast.">
  <div class="page-wrapper">
    <header class="page-header">
      <p class="page-eyebrow">about</p>
      <h1 class="page-title">0x42sec</h1>
    </header>

    <hr class="section-divider">

    <div class="about-body" style="padding-top: 48px;">
      <p class="about-lead">
        Security researcher and red team operator based in the UK. This site is a personal
        research lab — a place for technical writing on offensive security, RF and SIGINT,
        maritime systems, and hardware hacking.
      </p>
      <p class="about-text">
        Current projects include MSASP (Maritime &amp; SATCOM Adversary Simulation Platform),
        WRAITHSCAN (passive FPV drone SIGINT device), and the CT-ASF continuous red team
        framework. I work at the intersection of adversary simulation, quantitative risk
        modelling, and signals intelligence.
      </p>
      <p class="about-text">
        I approach security from an operator's perspective — focused on realistic threat
        emulation, measurable risk, and building things that actually work in the field.
      </p>

      <div class="skills-section">
        <p class="skills-label">expertise</p>
        <div class="skill-list">
          <div class="skill-item">Offensive adversary simulation</div>
          <div class="skill-item">Continuous red team (CT-ASF)</div>
          <div class="skill-item">Maritime &amp; SATCOM security</div>
          <div class="skill-item">AIS / NMEA / VSAT / Iridium</div>
          <div class="skill-item">Passive RF / SIGINT</div>
          <div class="skill-item">SDR, GNU Radio, DroneID</div>
          <div class="skill-item">FAIR / Monte Carlo risk modelling</div>
          <div class="skill-item">ATT&amp;CK TTP mapping</div>
          <div class="skill-item">Threat modelling (STRIDE, PASTA)</div>
          <div class="skill-item">CREST CPTIA</div>
          <div class="skill-item">Hardware hacking</div>
          <div class="skill-item">Embedded systems (ESP32, RPi)</div>
        </div>
      </div>
    </div>
  </div>
</Base>

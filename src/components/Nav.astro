---
const currentPath = Astro.url.pathname;
function isActive(path: string) {
  if (path === '/blog') return currentPath.startsWith('/blog');
  return currentPath === path;
}
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&family=Inconsolata:wght@300;400;500&display=swap" rel="stylesheet">

<nav class="site-nav">
  <a href="/" class="nav-logo">0x42sec</a>
  <ul class="nav-links">
    <li><a href="/about" class:list={[{ active: isActive('/about') }]}>About</a></li>
    <li><a href="/blog" class:list={[{ active: isActive('/blog') }]}>Blog</a></li>
    <li><a href="/projects" class:list={[{ active: isActive('/projects') }]}>Projects</a></li>
    <li><a href="/contact" class:list={[{ active: isActive('/contact') }]}>Contact</a></li>
    <li><a href="/" class="nav-terminal">&gt; terminal_</a></li>
  </ul>
</nav>
